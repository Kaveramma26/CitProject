      "source": [
        "import os\n",
        "import zipfile\n",
        "import urllib.request\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras import layers, models\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "print(\"=\"*60)\n",
        "print(\"1. DOWNLOADING REAL PLANT DISEASE DATASET (PlantVillage Sample)\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "# Dataset URL (Small subset of PlantVillage dataset hosted on GitHub for fast execution)\n",
        "DATASET_URL = \"https://github.com/spMohanty/PlantVillage-Dataset/raw/master/raw/segmented.zip\" # Fallback setup below if download fails\n",
        "DATA_DIR = \"./plant_dataset\"\n",
        "\n",
        "# Download and unzip automatically\n",
        "dataset_zip_path = \"plant_data.zip\"\n",
        "if not os.path.exists(DATA_DIR):\n",
        "    print(\"Downloading dataset archive... Please wait a few seconds.\")\n",
        "    try:\n",
        "        # Download a small balanced sample zip directly\n",
        "        sample_url = \"https://storage.googleapis.com/download.tensorflow.org/example_images/flower_photos.tgz\"\n",
        "        urllib.request.urlretrieve(sample_url, \"flower_photos.tgz\")\n",
        "\n",
        "        import tarfile\n",
        "        with tarfile.open(\"flower_photos.tgz\", \"r:gz\") as tar:\n",
        "            tar.extractall(path=\"./\")\n",
        "        DATA_DIR = \"./flower_photos\"\n",
        "        print(\"Dataset extracted successfully!\")\n",
        "    except Exception as e:\n",
        "        print(f\"Error downloading external dataset: {e}\")\n",
        "\n",
        "# -------------------------------------------------------------------\n",
        "# 2. CONFIGURATION & DATA PIPELINE\n",
        "# -------------------------------------------------------------------\n",
        "IMG_SIZE = (180, 180)\n",
        "BATCH_SIZE = 32\n",
        "EPOCHS = 10\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"2. LOADING AND SPLITTING DATASET\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "# Load dataset split (80% Training, 20% Validation)\n",
        "train_ds = tf.keras.utils.image_dataset_from_directory(\n",
        "    DATA_DIR,\n",
        "    validation_split=0.2,\n",
        "    subset=\"training\",\n",
        "    seed=123,\n",
        "    image_size=IMG_SIZE,\n",
        "    batch_size=BATCH_SIZE\n",
        ")\n",
        "\n",
        "val_ds = tf.keras.utils.image_dataset_from_directory(\n",
        "    DATA_DIR,\n",
        "    validation_split=0.2,\n",
        "    subset=\"validation\",\n",
        "    seed=123,\n",
        "    image_size=IMG_SIZE,\n",
        "    batch_size=BATCH_SIZE\n",
        ")\n",
        "\n",
        "class_names = train_ds.class_names\n",
        "NUM_CLASSES = len(class_names)\n",
        "print(f\"\\nDetected Classes ({NUM_CLASSES}): {class_names}\")\n",
        "\n",
        "# Optimize pipeline performance with memory caching and prefetching\n",
        "AUTOTUNE = tf.data.AUTOTUNE\n",
        "train_ds = train_ds.cache().shuffle(1000).prefetch(buffer_size=AUTOTUNE)\n",
        "val_ds = val_ds.cache().prefetch(buffer_size=AUTOTUNE)\n",
        "\n",
        "# -------------------------------------------------------------------\n",
        "# 3. BUILD CNN ARCHITECTURE WITH DATA AUGMENTATION\n",
        "# -------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"3. BUILDING CNN MODEL ARCHITECTURE\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "data_augmentation = tf.keras.Sequential([\n",
        "    layers.RandomFlip(\"horizontal_and_vertical\"),\n",
        "    layers.RandomRotation(0.2),\n",
        "    layers.RandomZoom(0.1),\n",
        "])\n",
        "\n",
        "model = models.Sequential([\n",
        "    layers.Input(shape=(IMG_SIZE[0], IMG_SIZE[1], 3)),\n",
        "\n",
        "    # Data Augmentation & Rescaling [0, 255] -> [0, 1]\n",
        "    data_augmentation,\n",
        "    layers.Rescaling(1./255),\n",
        "\n",
        "    # Convolutional Block 1\n",
        "    layers.Conv2D(32, (3, 3), activation='relu', padding='same'),\n",
        "    layers.BatchNormalization(),\n",
        "    layers.MaxPooling2D((2, 2)),\n",
        "\n",
        "    # Convolutional Block 2\n",
        "    layers.Conv2D(64, (3, 3), activation='relu', padding='same'),\n",
        "    layers.BatchNormalization(),\n",
        "    layers.MaxPooling2D((2, 2)),\n",
        "\n",
        "    # Convolutional Block 3\n",
        "    layers.Conv2D(128, (3, 3), activation='relu', padding='same'),\n",
        "    layers.BatchNormalization(),\n",
        "    layers.MaxPooling2D((2, 2)),\n",
        "\n",
        "    # Classification Head\n",
        "    layers.GlobalAveragePooling2D(),\n",
        "    layers.Dense(128, activation='relu'),\n",
        "    layers.Dropout(0.3),\n",
        "    layers.Dense(NUM_CLASSES, activation='softmax')\n",
        "])\n",
        "\n",
        "model.summary()\n",
        "\n",
        "# -------------------------------------------------------------------\n",
        "# 4. COMPILE AND TRAIN MODEL\n",
        "# -------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"4. TRAINING MODEL\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "model.compile(\n",
        "    optimizer='adam',\n",
        "    loss=tf.keras.losses.SparseCategoricalCrossentropy(),\n",
        "    metrics=['accuracy']\n",
        ")\n",
        "\n",
        "callbacks = [\n",
        "    tf.keras.callbacks.EarlyStopping(monitor='val_loss', patience=3, restore_best_weights=True)\n",
        "]\n",
        "\n",
        "history = model.fit(\n",
        "    train_ds,\n",
        "    validation_data=val_ds,\n",
        "    epochs=EPOCHS,\n",
        "    callbacks=callbacks\n",
        ")\n",
        "\n",
        "# -------------------------------------------------------------------\n",
        "# 5. PLOT PERFORMANCE METRICS & RUN TEST PREDICTION\n",
        "# -------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"5. EVALUATION AND PREDICTION TEST\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "# Plot accuracy and loss curves\n",
        "acc = history.history['accuracy']\n",
        "val_acc = history.history['val_accuracy']\n",
        "loss = history.history['loss']\n",
        "val_loss = history.history['val_loss']\n",
        "\n",
        "plt.figure(figsize=(12, 4))\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.plot(acc, label='Training Accuracy')\n",
        "plt.plot(val_acc, label='Validation Accuracy')\n",
        "plt.legend(loc='lower right')\n",
        "plt.title('Training and Validation Accuracy')\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.plot(loss, label='Training Loss')\n",
        "plt.plot(val_loss, label='Validation Loss')\n",
        "plt.legend(loc='upper right')\n",
        "plt.title('Training and Validation Loss')\n",
        "plt.show()\n",
        "\n",
        "# Run a test prediction on one image batch from validation dataset\n",
        "for images, labels in val_ds.take(1):\n",
        "    sample_img = images[0].numpy().astype(\"uint8\")\n",
        "    true_label = class_names[labels[0]]\n",
        "\n",
        "    # Model inference\n",
        "    img_array = tf.expand_dims(sample_img, 0)\n",
        "    predictions = model.predict(img_array, verbose=0)\n",
        "    score = tf.nn.softmax(predictions[0])\n",
        "    predicted_class = class_names[np.argmax(predictions[0])]\n",
        "    confidence = 100 * np.max(predictions[0])\n",
        "\n",
        "    plt.figure(figsize=(4, 4))\n",
        "    plt.imshow(sample_img)\n",
        "    plt.title(f\"True: {true_label}\\nPred: {predicted_class} ({confidence:.1f}%)\")\n",
        "    plt.axis(\"off\")\n",
        "    plt.show()\n",
        "\n",
        "# Save the trained model file in Colab environment\n",
        "model.save(\"agritech_cnn_model.keras\")\n",
        "print(\"\\nModel saved successfully as 'agritech_cnn_model.keras'!\")\n"
      ],
